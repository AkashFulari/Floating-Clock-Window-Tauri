{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coo-app",
  "version": "0.1.0",
  "identifier": "com.akash.coo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Overlay",
        "width": 275,
        "height": 275,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "shadow": false
      }
    ]
  }
}